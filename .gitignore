# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments & tooling caches
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Project data & outputs (raw CSVs, reports, model artifacts) — root-level only,
# NOT src/pitchprob/data or tests/data. The odds tape (data/tape/*.csv.gz)
# IS tracked: the GitHub Actions recorder commits daily snapshots (ADR 0012).
/data/*
!/data/tape/
/data/tape/*
!/data/tape/*.csv.gz
/reports/
/artifacts/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local scratch scripts
.setup-*.sh
.run-*.sh
